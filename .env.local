# J.A.R.V.I.S. – Umgebungsvariablen (Beispiel)
#
# Lokal auf dem Mac werden KEINE Secrets in Dateien gespeichert: sie liegen im macOS-Schlüsselbund
# (Dienst "jarvis", `cd core && uv run jarvisctl secret set <name>`). Diese Datei dokumentiert die
# Alternativen für Server/VPS-Betrieb und Konfigurations-Overrides. Nie mit echten Werten committen.

# --- Konfigurations-Overrides (überschreiben config/jarvis.yaml; Werte als YAML-Skalare) ---
# JARVIS_CONFIG_DIR=/opt/jarvis/config
# JARVIS__SERVER__HOST=127.0.0.1
# JARVIS__SERVER__PORT=8765
# JARVIS__SERVER__PUBLIC_BASE_URL=https://jarvis.example.com
# JARVIS__DATABASE__HOST=localhost
# JARVIS__DATABASE__NAME=jarvis
# JARVIS__LLM__OLLAMA_URL=http://127.0.0.1:11434
# JARVIS__HERMES__API_URL=http://127.0.0.1:8642/p/jarvis
# JARVIS__VOICE__ENABLED=false
# JARVIS__TELEPHONY__PROVIDER=twilio

# --- Secrets ohne Schlüsselbund (z. B. systemd credentials auf einem VPS) ---
# Name = JARVIS_SECRET_ + Schlüsselbund-Kontoname in Großbuchstaben, Sonderzeichen → "_"
# JARVIS_SECRET_POSTGRES=
# JARVIS_SECRET_HERMES_API_KEY=
# JARVIS_SECRET_HERMES_MCP_TOKEN=
# JARVIS_SECRET_LEXWARE_API_KEY=
# JARVIS_SECRET_GOOGLE_OAUTH_CLIENT=
# JARVIS_SECRET_GOOGLE_OAUTH_TOKEN=
# JARVIS_SECRET_TELEGRAM_BOT_TOKEN=
# JARVIS_SECRET_GITHUB_TOKEN=
# JARVIS_SECRET_FISH_AUDIO_API_KEY=
# JARVIS_SECRET_TWILIO_ACCOUNT_SID=
# JARVIS_SECRET_TWILIO_AUTH_TOKEN=
# JARVIS_SECRET_PHONE_PIN=
# JARVIS_SECRET_WEBHOOK_SIGNING_SECRET=
# JARVIS_SECRET_HTTP_API_TOKEN=

# --- Claude Code ---
# Wird bewusst NICHT gesetzt: der Coding-Runner entfernt ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN,
# damit Claude Code ausschließlich die Subscription-Anmeldung verwendet.
